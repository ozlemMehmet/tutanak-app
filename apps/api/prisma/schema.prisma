// Prisma semasi — factory/04-architecture/data-model.sql ile BIREBIR uyumludur
// (CLAUDE.md §1, §3.6: DDL tek dogruluk kaynagidir, sema ona uyar).
// Prisma'nin ifade edemedigi kisimlar (CHECK kisitlari, trigger'lar, uzantilar)
// migration SQL'inde elle tanimlidir; sema ile migration arasindaki tablo/sutun/index
// tutarliligi CI'da `prisma migrate diff --exit-code` ile dogrulanir (CLAUDE.md §9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enum tipleri (data-model.sql) ---

enum ReportStatus {
  draft
  shared
  approved

  @@map("report_status")
}

enum SubscriptionStatus {
  inactive
  pending
  active

  @@map("subscription_status")
}

enum PaymentStatus {
  initiated
  succeeded
  failed

  @@map("payment_status")
}

// MVP'de tek deger: paylasim teslim kaydi yalnizca sunucunun yaptigi gonderim icin yazilir.
enum ShareChannel {
  email

  @@map("share_channel")
}

enum DeliveryStatus {
  sent
  failed

  @@map("delivery_status")
}

// --- Tablolar ---

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @db.Citext
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  reports       Report[]
  subscriptions Subscription[]

  @@unique([email], map: "users_email_key")
  @@map("users")
}

model Template {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String
  name        String
  description String
  sortOrder   Int      @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  reports Report[]

  @@unique([code], map: "templates_code_key")
  @@unique([name], map: "templates_name_key")
  @@index([sortOrder], map: "templates_sort_order_idx")
  @@map("templates")
}

model Report {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  templateId String       @map("template_id") @db.Uuid
  title      String
  note       String       @default("")
  status     ReportStatus @default(draft)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  photos     ReportPhoto[]
  shareLink  ShareLink?
  approval   Approval?

  @@index([ownerId], map: "reports_owner_id_idx")
  @@index([templateId], map: "reports_template_id_idx")
  @@index([ownerId, createdAt(sort: Desc)], map: "reports_owner_created_at_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "reports_title_trgm_idx", type: Gin)
  @@index([note(ops: raw("gin_trgm_ops"))], map: "reports_note_trgm_idx", type: Gin)
  @@map("reports")
}

model ReportPhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String   @map("report_id") @db.Uuid
  storageKey  String   @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  widthPx     Int      @map("width_px")
  heightPx    Int      @map("height_px")
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  capturedAt  DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([storageKey], map: "report_photos_storage_key_key")
  @@index([reportId], map: "report_photos_report_id_idx")
  @@index([reportId, sortOrder, capturedAt], map: "report_photos_report_order_idx")
  @@map("report_photos")
}

model ShareLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  deliveries ShareDelivery[]
  approvals  Approval[]

  @@unique([token], map: "share_links_token_key")
  @@unique([reportId], map: "share_links_report_id_key")
  @@map("share_links")
}

model ShareDelivery {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shareLinkId       String         @map("share_link_id") @db.Uuid
  channel           ShareChannel   @default(email)
  recipientEmail    String         @map("recipient_email") @db.Citext
  status            DeliveryStatus
  providerMessageId String?        @map("provider_message_id")
  errorMessage      String?        @map("error_message")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId], map: "share_deliveries_share_link_id_idx")
  @@index([createdAt(sort: Desc)], map: "share_deliveries_created_at_idx")
  @@map("share_deliveries")
}

model Approval {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId      String   @map("report_id") @db.Uuid
  shareLinkId   String   @map("share_link_id") @db.Uuid
  approverEmail String   @map("approver_email") @db.Citext
  approvedAt    DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@unique([reportId], map: "approvals_report_id_key")
  @@index([shareLinkId], map: "approvals_share_link_idx")
  @@map("approvals")
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  status           SubscriptionStatus @default(inactive)
  priceAmount      Decimal?           @map("price_amount") @db.Decimal(12, 2)
  currency         String             @default("TRY") @db.Char(3)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  provider         String
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions PaymentTransaction[]

  @@unique([userId], map: "subscriptions_user_id_key")
  @@index([status], map: "subscriptions_status_idx")
  @@map("subscriptions")
}

model PaymentTransaction {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  providerReference String        @map("provider_reference")
  status            PaymentStatus @default(initiated)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("TRY") @db.Char(3)
  failureReason     String?       @map("failure_reason")
  processedAt       DateTime?     @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([providerReference], map: "payment_transactions_provider_ref_key")
  @@index([subscriptionId], map: "payment_transactions_subscription_id_idx")
  @@index([createdAt(sort: Desc)], map: "payment_transactions_created_at_idx")
  @@map("payment_transactions")
}
