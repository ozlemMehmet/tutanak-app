# Ornek ortam degiskenleri — GERCEK DEGER YAZILMAZ.
# `cp .env.example .env` sonrasi yerel varsayilanlar calisir durumdadir (CLAUDE.md §5, §10).

# --- Sirlar (CLAUDE.md §5 tam listesi) ---
# Postgres baglanti adresi
DATABASE_URL=postgresql://tutanak:tutanak@localhost:5432/tutanak
# JWT imzalama anahtari — uretimde uzun ve rastgele bir deger kullanin
JWT_SECRET=degistirin-yerel-gelistirme-anahtari
# Obje depolama (uretim: Cloudflare R2, yerel: MinIO)
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=tutanak-photos
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
# Islemsel e-posta saglayicisi (Resend). Bos birakilabilir: uygulama yine acilir,
# gonderim denemesi 202 + status=failed olarak raporlanir (CLAUDE.md §4.2.2, §10).
RESEND_API_KEY=
# Odeme saglayicisi anahtarlari — yalnizca PAYMENT_PROVIDER=iyzico iken zorunludur
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_WEBHOOK_SECRET=

# --- Sir olmayan yapilandirma (CLAUDE.md §5.1) ---
# Abonelik tutari — ondalikli string, para birimi float'a cevrilmez
SUBSCRIPTION_PRICE_AMOUNT=199.00
# Para birimi (char(3))
SUBSCRIPTION_CURRENCY=TRY
# Abonelik donem uzunlugu (gun)
SUBSCRIPTION_PERIOD_DAYS=30
# Paylasim e-postasinin gonderen adresi
EMAIL_FROM=Tutanak <noreply@localhost>
# Odeme saglayicisi secimi: iyzico | fake — ZORUNLUDUR, varsayilani YOKTUR (T-024/S-03):
# tanimsizken uygulama acilmaz. Uretimde (NODE_ENV=production) `fake` REDDEDILIR, cunku
# sahte saglayici webhook imzasini dogrulamaz. NODE_ENV bu dosyada bilincli olarak YOKTUR:
# uretim imaji NODE_ENV=production tasir ve `.env`'e yazilacak bir deger onu ezerdi.
PAYMENT_PROVIDER=fake
# Fotograf boyut ust siniri (bayt)
PHOTO_MAX_BYTES=10485760
# Tutanak basina fotograf ust siniri
PHOTO_MAX_PER_REPORT=30
# Erisim tokeni omru
JWT_EXPIRES_IN=7d
# Fotograf on-imzali okuma URL omru (saniye)
PRESIGNED_URL_TTL_SECONDS=900
# Fotograf on-imzali URL'sinin TARAYICIYA donen adresi (sir DEGIL, yalnizca adrestir).
# Bos birakilirsa R2_ENDPOINT kullanilir. Docker aginda R2_ENDPOINT servis adidir
# (http://minio:9000) ve tarayici bunu cozemez; asagidaki deger host tarafindan acilir.
# Telefondan (LAN) denemek icin makinenin IP'siyle degistirin: http://192.168.1.x:9000
# Uretimde R2'nin genel alan adi yazilir (ic adresle ayni olabilir).
# DIKKAT (T-024/S-02): bu deger API'ye OLDUGU GIBI `web` (Caddy) container'ina da
# verilmelidir — uretim imajindaki CSP `img-src`/`connect-src` kokenini bundan turetir.
# Verilmezse veya farkli olursa fotograflar tarayicida SESSIZCE engellenir (sunucu
# tarafinda hicbir hata gorunmez). Ornek: docker-compose.e2e.yml `web.environment`.
R2_PUBLIC_ENDPOINT=http://localhost:9000
# Paylasim linkinin ve wa.me metninin tabani
PUBLIC_APP_URL=http://localhost:5173
# Hiz siniri penceresi (saniye) — sayac bellek ici, endpoint + IP basina
RATE_LIMIT_WINDOW_SECONDS=60
# Pencere basina genel istek ust siniri
RATE_LIMIT_MAX_REQUESTS=300
# Kimlik uclari (/auth/register, /auth/login) icin sikilastirilmis ust sinir
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# --- Web (yalnizca gelistirme araci; sir DEGIL, tarayici paketine girmez) ---
# Vite gelistirme sunucusunun `/api` isteklerini tasidigi hedef. `docker compose` icinde
# servis adiyla (http://api:3000) ezilir; host uzerinde `npm run dev` icin varsayilan yeterlidir.
VITE_API_PROXY_TARGET=http://localhost:3000
